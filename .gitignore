# Secrets — never commit
client_secret*.json
token*.json
*.pem
*.key

# Local state
state.json
*.lock

# Media — do not commit inputs/outputs
videos/audio/
videos/images/
videos/output/
videos/recordings/
videos/render.log
*.mp4
*.mov
*.mkv
*.wav
*.mp3
*.m4a
*.flac

# Python
__pycache__/
*.pyc

# Bildkasten local state and image library
bildkasten/.venv/
bildkasten/venv/
bildkasten/data/
bildkasten/images/
bildkasten/library/
bildkasten/models/
bildkasten/test.py
bildkasten/*.jpg
bildkasten/*.jpeg
bildkasten/*.png
bildkasten/*.webp
bildkasten/*.gif
bildkasten/*.heic
!bildkasten/flake.lock
